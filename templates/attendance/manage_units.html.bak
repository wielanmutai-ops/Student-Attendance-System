{% extends 'attendance/base.html' %}
{% block content %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-book text-primary me-2"></i>Manage Units
        </h2>
        <a href="{% url 'create_unit' %}" class="btn btn-success">
            <i class="fas fa-plus me-1"></i> Add New Unit
        </a>
    </div>

    <!-- Messages -->
    {% if messages %}
    <div class="mb-3">
        {% for message in messages %}
        <div class="alert alert-{{ message.tags }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Unit Code</th>
                            <th>Unit Name</th>
                            <th>Course</th>
                            <th>Lecturer</th>
                            <th>Semester</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for unit in units %}
                        <tr>
                            <td><strong>{{ unit.code }}</strong></td>
                            <td>{{ unit.name }}</td>
                            <td>
                                {% if unit.course %}
                                <span class="badge bg-info">{{ unit.course.code }}</span>
                                {% else %}
                                <span class="badge bg-secondary">No Course</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if unit.lecturer %}
                                {{ unit.lecturer.user.get_full_name|default:unit.lecturer.user.username }}
                                {% else %}
                                <span class="badge bg-warning">Unassigned</span>
                                {% endif %}
                            </td>
                            <td><span class="badge bg-dark">Sem {{ unit.semester }}</span></td>
                            <td>
                                <a href="{% url 'edit_unit' unit.id %}" class="btn btn-sm btn-warning">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <a href="{% url 'delete_unit' unit.id %}" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Are you sure you want to delete this unit?');">
                                    <i class="fas fa-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                        {% empty %}
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                <i class="fas fa-book fa-3x text-muted mb-3"></i>
                                <h4 class="text-muted">No Units Found</h4>
                                <p class="text-muted">Start by adding your first unit</p>
                                <a href="{% url 'create_unit' %}" class="btn btn-primary">
                                    <i class="fas fa-plus me-1"></i> Create First Unit
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}